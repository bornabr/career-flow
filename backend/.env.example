# Career Flow Backend Environment
# Copy this file to .env and fill in your values

# LLM Provider configuration
# Format: provider:model_id (e.g., google:gemini-2.5-pro, openai:gpt-4o, anthropic:claude-sonnet-4-20250514)
MODEL_NAME=google:gemini-2.5-pro

# API key — use the generic API_KEY or provider-specific variants
# The backend auto-resolves: API_KEY > GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY
API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application settings
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_SIZE_MB=10
