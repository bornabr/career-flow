{
  "private": true,
  "name": "career-flow",
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "dev:web": "pnpm --filter @career-flow/web dev",
    "dev:backend": "pnpm --filter @career-flow/web dev & cd backend && poetry run uvicorn app.main:app --reload --port 8000",
    "build:web": "pnpm --filter @career-flow/web build"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
